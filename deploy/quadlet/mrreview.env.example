# Secrets for app.container — copy next to the units as mrreview.env,
# chmod 600, and edit. This template ships in the repo; the real file must
# never be committed.
DATABASE_URL=postgresql+psycopg://mrreview:change-me@mrreview-postgres:5432/mrreview
SESSION_SECRET=
APP_PASSWORD_HASH=
SECRET_ENC_KEY=
# Optional:
ANTHROPIC_API_KEY=
