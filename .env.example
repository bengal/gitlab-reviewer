# GitLab MR auto-review tool — environment variables
# Copy to .env for local development. .env is git-ignored.

# Database URL. SQLite for dev, Postgres in prod:
#   postgresql+psycopg://user:pass@host:5432/mrreview
DATABASE_URL=sqlite:///./dev.sqlite3

# Secret for signing the session cookie. Any long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# PBKDF2 hash of the shared app password (format: pbkdf2$<iter>$<salt_hex>$<hash_hex>).
# Generate with:
#   uv run python -c "from app.security import hash_password; print(hash_password('your-password'))"
APP_PASSWORD_HASH=

# Fernet key for encrypting secrets at rest (GitLab token, model API keys).
# Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENC_KEY=

# Base URL of the shared llama.cpp server (OpenAI-compatible /v1). Optional.
LLAMA_BASE_URL=

# Anthropic API key. Optional; keys may also be stored per model profile.
ANTHROPIC_API_KEY=

# Container image used for ephemeral review runs.
REVIEW_IMAGE=gitlab-mr-review/review-runner:latest

# Comma-separated allowlist of image names/prefixes the podman orchestrator
# may run (e.g. "gitlab-mr-review/review-runner" allows any tag). Empty means
# only REVIEW_IMAGE itself is allowed.
REVIEW_IMAGE_ALLOWLIST=

# Network for review containers (default: host, for GitLab/llama reachability).
PODMAN_NETWORK=host

# Hard per-review timeout in seconds (default: 1800 = 30 minutes).
REVIEW_TIMEOUT_SECONDS=1800

# Host directory holding the persistent checkouts of the extra (library)
# repos: the app keeps one checkout per library here, re-pulls it when it
# is older than LIBRARY_PULL_MAX_AGE_HOURS, and mounts it read-only into
# each review container. Default: ~/.local/share/mr-review/libraries.
# In the compose/quadlet deployments the directory is mounted into the app
# container at the SAME path (review containers are created by the host's
# podman, whose bind sources must be host paths).
LIBRARY_CHECKOUT_DIR=

# Re-pull a library checkout when it is older than this many hours
# (default: 24; 0 = pull before every review).
LIBRARY_PULL_MAX_AGE_HOURS=24

# Orchestrator backend: podman (real containers) or fake (dev/tests).
ORCHESTRATOR=podman

# Set to 1 to disable the background scheduler entirely (no queue pump, no
# nightly cron). Jobs can still be pumped manually (worker.pump_once).
DISABLE_SCHEDULER=0

# ---------------------------------------------------------------------------
# Deployment (podman compose / quadlet) — consumed by the deployment files,
# NOT by the app itself.
# ---------------------------------------------------------------------------

# Path to the host's rootless podman socket the app container mounts so it
# can spawn review containers (`podman run --rm`). For a host user with uid
# 1000 the default is fine. Enable the socket first:
#   systemctl --user enable --now podman.socket
PODMAN_SOCKET=/run/user/1000/podman/podman.sock

# Host directory holding the llama.cpp model file(s) (compose: mounted into
# llama-server at /models), and the model file to load.
LLAMA_MODEL_DIR=./models
LLAMA_MODEL_FILE=model.gguf

# Postgres credentials (compose defaults; keep in sync with DATABASE_URL if
# you override it).
POSTGRES_USER=mrreview
POSTGRES_PASSWORD=mrreview
POSTGRES_DB=mrreview
