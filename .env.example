# GitLab MR auto-review tool — environment variables
# Copy to .env for local development. .env is git-ignored.

# Database URL. SQLite for dev, Postgres in prod:
#   postgresql+psycopg://user:pass@host:5432/mrreview
DATABASE_URL=sqlite:///./dev.sqlite3

# Secret for signing the session cookie. Any long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# PBKDF2 hash of the shared app password (format: pbkdf2$<iter>$<salt_hex>$<hash_hex>).
# Generate with:
#   uv run python -c "from app.security import hash_password; print(hash_password('your-password'))"
APP_PASSWORD_HASH=

# Fernet key for encrypting secrets at rest (GitLab token, model API keys).
# Generate with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENC_KEY=

# Base URL of the shared llama.cpp server (OpenAI-compatible /v1). Optional.
LLAMA_BASE_URL=

# Anthropic API key. Optional; keys may also be stored per model profile.
ANTHROPIC_API_KEY=

# Container image used for ephemeral review runs.
REVIEW_IMAGE=gitlab-mr-review/review-runner:latest

# Comma-separated allowlist of image names/prefixes the podman orchestrator
# may run (e.g. "gitlab-mr-review/review-runner" allows any tag). Empty means
# only REVIEW_IMAGE itself is allowed.
REVIEW_IMAGE_ALLOWLIST=

# Network for review containers (default: host, for GitLab/llama reachability).
PODMAN_NETWORK=host

# Hard per-review timeout in seconds (default: 1800 = 30 minutes).
REVIEW_TIMEOUT_SECONDS=1800

# Orchestrator backend: podman (real containers) or fake (dev/tests).
ORCHESTRATOR=podman
